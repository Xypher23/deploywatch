# Discord channel webhook for down alerts. Copy this file to .env and fill it in.
# Never commit .env.
DISCORD_WEBHOOK_URL=

# Database URL. For local development with SQLite (default):
# DATABASE_URL=sqlite:///./deploywatch.db
#
# For Docker Compose with PostgreSQL:
# DATABASE_URL=postgresql://deploywatch:deploywatch@postgres:5432/deploywatch
#
# For production (managed PostgreSQL on Render/Railway/AWS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=